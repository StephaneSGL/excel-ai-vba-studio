{
  "name": "excel-ai-vba-studio",
  "displayName": "Excel AI & VBA Studio",
  "description": "View spreadsheets and work with Excel data, VBA projects, UserForms, and GitHub Copilot directly in VS Code.",
  "version": "0.2.1",
  "publisher": "steph-tools",
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/StephaneSGL/excel-ai-vba-studio.git"
  },
  "homepage": "https://github.com/StephaneSGL/excel-ai-vba-studio#readme",
  "bugs": {
    "url": "https://github.com/StephaneSGL/excel-ai-vba-studio/issues"
  },
  "icon": "image/marketplace-icon.png",
  "galleryBanner": {
    "color": "#107C41",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": ">=1.95.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Visualization",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "excel",
    "xlsx",
    "xlsm",
    "xls",
    "xlsb",
    "csv",
    "spreadsheet",
    "workbook",
    "formula",
    "vba",
    "macro",
    "developer",
    "artificial intelligence",
    "copilot",
    "data"
  ],
  "qna": "https://github.com/StephaneSGL/excel-ai-vba-studio/discussions",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Exporting workbook or VBA context uses local Office automation and therefore requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Excel and VBA project extraction requires local Windows files."
    }
  },
  "activationEvents": [
    "onCustomEditor:excelAiVbaStudio.officeViewer",
    "onView:excelAiVbaExplorer",
    "onLanguageModelTool:excel_ai_vba_readWorkbook",
    "onLanguageModelTool:excel_ai_vba_writeModule",
    "onLanguageModelTool:excel_ai_vba_designWorkbook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "excelAiVbaStudio.exportWorkbook",
        "title": "Excel AI & VBA Studio : Exporter le contexte du classeur",
        "icon": "$(sparkle-filled)",
        "enablement": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb' || resourceExtname == '.csv' || resourceExtname == '.tsv'"
      },
      {
        "command": "excelAiVbaStudio.copyWorkbookContext",
        "title": "Excel AI & VBA Studio : Exporter et copier le contexte",
        "icon": "$(copy)",
        "enablement": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb' || resourceExtname == '.csv' || resourceExtname == '.tsv'"
      },
      {
        "command": "excelAiVbaStudio.openWorkbookContext",
        "title": "Excel AI & VBA Studio : Ouvrir le dernier contexte exporté",
        "icon": "$(book-open)"
      },
      {
        "command": "excelAiVbaStudio.copyGeneratedContext",
        "title": "Excel AI & VBA Studio : Copier le dernier contexte exporté",
        "icon": "$(clippy)"
      },
      {
        "command": "excelAiVbaStudio.openExcel",
        "title": "Excel AI & VBA Studio : Ouvrir le classeur dans Microsoft Excel",
        "icon": "$(file)"
      },
      {
        "command": "excelAiVbaStudio.openVbe",
        "title": "Excel AI & VBA Studio : Ouvrir le VBE natif d’Excel",
        "icon": "$(window)"
      },
      {
        "command": "excelAiVbaStudio.openVbaDeveloper",
        "title": "Excel AI & VBA Studio : Ouvrir le studio VBA dans VS Code",
        "icon": "$(code)",
        "enablement": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
      },
      {
        "command": "excelAiVbaStudio.openVbaExplorer",
        "title": "Excel AI & VBA Studio : Ouvrir le projet VBA dans VS Code",
        "icon": "$(folder-opened)",
        "enablement": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
      },
      {
        "command": "excelAiVbaStudio.askCopilotAboutWorkbook",
        "title": "Excel AI & VBA Studio : Analyser le classeur et le VBA avec Copilot",
        "icon": "$(copilot)",
        "enablement": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
      },
      {
        "command": "excelAiVbaStudio.refreshExplorer",
        "title": "Excel AI & VBA Studio : Actualiser l’explorateur",
        "icon": "$(refresh)"
      },
      {
        "command": "excelAiVbaStudio.cleanExports",
        "title": "Excel AI & VBA Studio : Nettoyer les exports générés",
        "icon": "$(trash)"
      }
    ],
    "languageModelTools": [
      {
        "name": "excel_ai_vba_readWorkbook",
        "displayName": "Lire un classeur Excel local",
        "toolReferenceName": "excelVbaWorkbook",
        "canBeReferencedInPrompt": true,
        "icon": "$(table)",
        "userDescription": "Lit localement un classeur Excel et fournit ses valeurs, formules, métadonnées et, si autorisé, son contexte VBA.",
        "modelDescription": "Utilise cet outil pour inspecter un classeur Excel local. Il produit un contexte Markdown ou JSON borné, sans clé API et sans télémétrie. Le code VBA est inclus uniquement lorsque Microsoft Excel autorise explicitement l’accès programmatique au projet VBA.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workbookPath": {
              "type": "string",
              "description": "Chemin absolu, URI file:// ou chemin relatif au dossier VS Code. Omettre pour utiliser le classeur actif."
            },
            "includeVba": {
              "type": "boolean",
              "description": "Inclure les modules et références VBA lorsque l’accès programmatique est autorisé."
            },
            "format": {
              "type": "string",
              "enum": [
                "markdown",
                "json"
              ],
              "default": "markdown",
              "description": "Format du contexte retourné au modèle."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "excel_ai_vba_writeModule",
        "displayName": "Réinjecter un module VBA",
        "toolReferenceName": "excelVbaWriteModule",
        "canBeReferencedInPrompt": true,
        "icon": "$(save)",
        "userDescription": "Réinjecte transactionnellement un composant VBA. Une première écriture .bas/.cls dans un XLSX crée une copie XLSM voisine ; XLSM/XLAM conservent sauvegarde et validation.",
        "modelDescription": "Utilise cet outil pour toute écriture réelle de code VBA. Il refuse toujours un chemin contenant le composant exact .excel-ai-vba-backups. Pour un .xlsx, la première écriture d’un .bas ou .cls crée une copie .xlsm voisine sans modifier la source : toutes les écritures suivantes doivent utiliser le targetWorkbookPath renvoyé. Pour un .xlsm/.xlam, il met à jour un composant existant ou ajoute un .bas/.cls avec sauvegarde transactionnelle. Il ne lance aucune macro et ne modifie jamais AccessVBOM. Un .frm est accepté uniquement pour le code d’un UserForm déjà présent dans un .xlsm/.xlam ; la création d’un UserForm, de son designer, de ses contrôles ou de son .frx est refusée.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workbookPath": {
              "type": "string",
              "description": "Chemin absolu, URI file:// ou chemin relatif au dossier VS Code. Un .xlsx produit une copie .xlsm voisine et l’outil renvoie son targetWorkbookPath. Omettre pour utiliser le classeur actif."
            },
            "componentFile": {
              "type": "string",
              "description": "Nom sans chemin du composant .bas, .cls ou .frm. Un nouveau .bas ou .cls peut être créé. Un .frm doit déjà exister dans un .xlsm/.xlam."
            },
            "source": {
              "type": "string",
              "description": "Source complet du composant. Limite : 2 000 000 de caractères."
            }
          },
          "required": [
            "componentFile",
            "source"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "excel_ai_vba_designWorkbook",
        "displayName": "Créer des UserForms et boutons VBA",
        "toolReferenceName": "excelVbaDesignWorkbook",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-interface)",
        "userDescription": "Crée transactionnellement de vrais UserForms, leurs contrôles visuels et des boutons de feuille affectés à des macros dans un classeur XLSM existant.",
        "modelDescription": "Utilise cet outil pour créer un UserForm complet avec son designer et ses flux .frx, ajouter des contrôles visuels à un UserForm, ou créer un bouton de formulaire sur une feuille Excel. Le classeur doit être un .xlsm local existant. Chaque écriture utilise une copie de travail, crée une sauvegarde, vérifie les flux UserForm, puis remplace le fichier atomiquement. Aucune macro n’est exécutée et le réglage AccessVBOM n’est jamais modifié.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workbookPath": {
              "type": "string",
              "description": "Chemin absolu, URI file:// ou chemin relatif au dossier VS Code vers un classeur .xlsm existant. Omettre pour utiliser le classeur actif."
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "createUserForm"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,30}$"
                      },
                      "caption": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      },
                      "source": {
                        "type": "string",
                        "maxLength": 2000000,
                        "description": "Code VBA du UserForm, sans en-tête VERSION/BEGIN/Attribute VB_."
                      },
                      "controls": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "label",
                                "textBox",
                                "commandButton",
                                "comboBox",
                                "listBox",
                                "checkBox",
                                "optionButton",
                                "toggleButton",
                                "frame",
                                "image",
                                "spinButton",
                                "scrollBar"
                              ]
                            },
                            "name": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,30}$"
                            },
                            "left": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 10000
                            },
                            "top": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 10000
                            },
                            "width": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 10000
                            },
                            "height": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 10000
                            },
                            "caption": {
                              "type": "string",
                              "maxLength": 1000
                            },
                            "enabled": {
                              "type": "boolean"
                            },
                            "visible": {
                              "type": "boolean"
                            },
                            "tabIndex": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 32767
                            },
                            "controlTipText": {
                              "type": "string",
                              "maxLength": 1000
                            }
                          },
                          "required": [
                            "type",
                            "name",
                            "left",
                            "top",
                            "width",
                            "height"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "addUserFormControl"
                        ]
                      },
                      "formName": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,30}$"
                      },
                      "control": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "label",
                              "textBox",
                              "commandButton",
                              "comboBox",
                              "listBox",
                              "checkBox",
                              "optionButton",
                              "toggleButton",
                              "frame",
                              "image",
                              "spinButton",
                              "scrollBar"
                            ]
                          },
                          "name": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,30}$"
                          },
                          "left": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "top": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "width": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 10000
                          },
                          "height": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 10000
                          },
                          "caption": {
                            "type": "string",
                            "maxLength": 1000
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "visible": {
                            "type": "boolean"
                          },
                          "tabIndex": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 32767
                          },
                          "controlTipText": {
                            "type": "string",
                            "maxLength": 1000
                          }
                        },
                        "required": [
                          "type",
                          "name",
                          "left",
                          "top",
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "formName",
                      "control"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "createWorksheetButton"
                        ]
                      },
                      "sheetName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,30}$"
                      },
                      "caption": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "macroName": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,30}(\\.[A-Za-z_][A-Za-z0-9_]{0,30})?$"
                      },
                      "left": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "top": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      }
                    },
                    "required": [
                      "kind",
                      "sheetName",
                      "name",
                      "caption",
                      "macroName",
                      "left",
                      "top",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "operations"
          ],
          "additionalProperties": false
        }
      }
    ],
    "keybindings": [
      {
        "command": "excelAiVbaStudio.openVbaDeveloper",
        "key": "ctrl+alt+f11",
        "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "excelAiVbaStudio.exportWorkbook",
          "group": "navigation@1",
          "when": "view == excelAiVbaExplorer"
        },
        {
          "command": "excelAiVbaStudio.openVbaExplorer",
          "group": "navigation@2",
          "when": "view == excelAiVbaExplorer"
        },
        {
          "command": "excelAiVbaStudio.askCopilotAboutWorkbook",
          "group": "navigation@3",
          "when": "view == excelAiVbaExplorer"
        },
        {
          "command": "excelAiVbaStudio.refreshExplorer",
          "group": "navigation@4",
          "when": "view == excelAiVbaExplorer"
        }
      ],
      "editor/title": [
        {
          "command": "excelAiVbaStudio.openVbaExplorer",
          "group": "navigation@1",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
        },
        {
          "command": "excelAiVbaStudio.askCopilotAboutWorkbook",
          "group": "navigation@2",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
        },
        {
          "command": "excelAiVbaStudio.exportWorkbook",
          "group": "navigation@3",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb' || resourceExtname == '.csv' || resourceExtname == '.tsv'"
        }
      ],
      "explorer/context": [
        {
          "command": "excelAiVbaStudio.openVbaExplorer",
          "group": "excelAiVbaStudio@1",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
        },
        {
          "command": "excelAiVbaStudio.askCopilotAboutWorkbook",
          "group": "excelAiVbaStudio@2",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb'"
        },
        {
          "command": "excelAiVbaStudio.exportWorkbook",
          "group": "excelAiVbaStudio@3",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb' || resourceExtname == '.csv' || resourceExtname == '.tsv'"
        },
        {
          "command": "excelAiVbaStudio.copyWorkbookContext",
          "group": "excelAiVbaStudio@4",
          "when": "resourceExtname == '.xlsx' || resourceExtname == '.xlsm' || resourceExtname == '.xls' || resourceExtname == '.xlsb' || resourceExtname == '.csv' || resourceExtname == '.tsv'"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "excelAiVbaExplorer",
          "name": "Projet Excel & VBA",
          "visibility": "visible"
        },
        {
          "id": "excelAiVbaProperties",
          "name": "Propriétés VBA",
          "visibility": "visible"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "excelAiVbaStudio.officeViewer",
        "displayName": "Excel AI & VBA Studio",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Excel AI & VBA Studio",
      "properties": {
        "excelAiVbaStudio.maxRows": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 5000,
          "description": "Nombre maximal de lignes exportées par feuille pour le contexte IA (de 1 à 5 000)."
        },
        "excelAiVbaStudio.maxColumns": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 256,
          "description": "Nombre maximal de colonnes exportées par feuille pour le contexte IA (de 1 à 256)."
        },
        "excelAiVbaStudio.includeVba": {
          "type": "boolean",
          "default": false,
          "description": "Inclure les modules et références VBA lorsque Microsoft Excel autorise l’accès programmatique."
        }
      }
    }
  },
  "scripts": {
    "dev": "vite --mode=development",
    "typecheck": "tsc --noEmit",
    "build": "vite build --mode=production",
    "vscode:prepublish": "npm run build",
    "validate:manifest": "node tools/validate-manifest.mjs",
    "validate:workbook-access": "node tools/validate-noninteractive-workbook-access.mjs",
    "validate:macro-readonly": "node tools/validate-macro-readonly.mjs",
    "validate:native-xlsm": "node tools/validate-native-xlsm-editing.mjs",
    "validate:vba-studio": "node tools/validate-vba-studio.mjs",
    "validate:vba-bootstrap": "node tools/validate-vba-bootstrap.mjs",
    "validate:vba-writeback": "node tools/validate-vba-writeback.mjs",
    "validate:vba-designer": "node tools/validate-vba-designer.mjs",
    "test:vba-bootstrap": "node test/vba-bootstrap-integration.mjs",
    "test:vba-writeback": "node test/vba-writeback-regression.mjs",
    "test:vba-designer": "node test/vba-designer-integration.mjs",
    "test:vba-atomic": "python test/atomic-writeback-regression.py",
    "test:xlsx-prefixes": "node test/xlsx-namespace-prefix-regression.mjs",
    "test:native-diff": "node test/native-edit-regression.mjs",
    "test:native-xlsm": "node test/native-xlsm-integration.mjs",
    "validate:theme-sync": "node tools/validate-theme-sync.mjs",
    "validate:integrated-features": "node tools/validate-integrated-features.mjs",
    "validate:licenses": "node tools/generate-third-party-licenses.mjs --check",
    "validate:performance": "node tools/validate-performance.mjs",
    "validate:package": "node tools/validate-package.mjs",
    "validate": "npm run validate:manifest && npm run validate:workbook-access && npm run validate:macro-readonly && npm run validate:native-xlsm && npm run validate:vba-studio && npm run validate:vba-bootstrap && npm run validate:vba-writeback && npm run validate:vba-designer && npm run test:vba-bootstrap && npm run test:vba-writeback && npm run test:vba-designer && npm run test:vba-atomic && npm run test:xlsx-prefixes && npm run test:native-diff && npm run test:native-xlsm && npm run validate:theme-sync && npm run validate:integrated-features && npm run validate:licenses && npm run typecheck && npm run build && npm run validate:performance && npm run validate:package",
    "package": "node tools/package-extension.mjs",
    "release:check": "node tools/release-check.mjs",
    "release:prepare": "node tools/prepare-release.mjs"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.3.5",
    "@cweijan/exceljs": "^5.0.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.1",
    "antd": "^5.15.4",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "less": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
